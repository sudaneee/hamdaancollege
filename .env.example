SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8123

# ZainPay — leave blank to disable payment initiation (it fails loudly
# instead of silently succeeding). Get real values from your ZainPay
# dashboard / zainbox.
ZAINPAY_PUBLIC_KEY=
ZAINPAY_ZAINBOX_CODE=
ZAINPAY_BASE_URL=https://sandbox.zainpay.ng
ZAINPAY_CALLBACK_URL=http://127.0.0.1:8123/payments/zainpay/callback/
ZAINPAY_SECRET_KEY=
ZAINPAY_RECONCILE_LOOKBACK_HOURS=720

# Email (Gmail SMTP) — a Gmail address + App Password. Blank is fine for
# dev; sends just fail-log instead of erroring (see hamdaan_cms/emails.py).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
